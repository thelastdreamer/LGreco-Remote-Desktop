# Database
DB_USER=rduser
DB_PASSWORD=change_this_password
DB_NAME=remote_desktop

# API
API_PORT=8080
JWT_SECRET=change-me-to-a-random-64-character-string-at-least-32-bytes

# Domain / Public IP (for Coturn TURN server)
DOMAIN=your-domain.com
PUBLIC_IP=auto

# TURN / STUN
# Public ports: 3478/tcp+udp (signaling) and 49152-49201/udp (50 relay ports max)
STUN_SERVER=stun:stun.l.google.com:19302
TURN_USERNAME=rdturnuser
TURN_PASSWORD=change_this_turn_password

# Docker network for session containers
DOCKER_NETWORK=rd-network
