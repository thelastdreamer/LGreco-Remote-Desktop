<Window x:Class="RemoteDesktop.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RemoteDesktop.Client.Controls"
        Title="Remote Desktop"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <!-- Login Panel -->
            <Border x:Name="LoginPanel" Background="Transparent" Visibility="Visible">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Decorative Top -->
                    <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="12,12,0,0" Opacity="0.05"/>

                    <!-- Login Card -->
                    <StackPanel Grid.Row="1" Width="400" HorizontalAlignment="Center">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="40,35" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Remote Desktop"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="#E8E8FF"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Secure remote access, anywhere"
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                                <!-- Server URL -->
                                <TextBlock Text="SERVER" Foreground="#6C63FF" FontSize="10" FontWeight="SemiBold"
                                           Margin="2,0,0,4"/>
                                <TextBox x:Name="ServerUrlBox" Text="http://localhost:8080" Margin="0,0,0,16"
                                         Style="{StaticResource InputStyle}"/>

                                <!-- Username -->
                                <TextBlock Text="USERNAME" Foreground="#6C63FF" FontSize="10" FontWeight="SemiBold"
                                           Margin="2,0,0,4"/>
                                <TextBox x:Name="UsernameBox" Margin="0,0,0,16"
                                         Style="{StaticResource InputStyle}"/>

                                <!-- Password -->
                                <TextBlock Text="PASSWORD" Foreground="#6C63FF" FontSize="10" FontWeight="SemiBold"
                                           Margin="2,0,0,4"/>
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                                        BorderBrush="#3D3D55" BorderThickness="1">
                                    <PasswordBox x:Name="PasswordBox" Background="Transparent"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderThickness="0" Padding="10,8" FontSize="14"/>
                                </Border>

                                <!-- Error -->
                                <TextBlock x:Name="LoginError"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontSize="12" HorizontalAlignment="Center"
                                           Margin="0,14,0,0" Visibility="Collapsed"
                                           TextWrapping="Wrap"/>

                                <!-- Button -->
                                <Button x:Name="LoginButton" Content="CONNECT"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="46" Margin="0,24,0,0" Click="LoginButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Decorative Bottom -->
                    <Border Grid.Row="2" Background="Transparent"/>
                </Grid>
            </Border>

            <!-- Main Panel -->
            <Grid x:Name="MainPanel" Visibility="Collapsed">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                    </EventTrigger>
                </Grid.Triggers>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- Title Bar / Top Bar -->
                <Border Grid.Row="0" Background="#1A1A2E" CornerRadius="12,12,0,0"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid Margin="16,0">
                        <!-- Left: App name + Status -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RD"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Background="#6C63FF33" CornerRadius="3" Padding="6,2" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF6B6B"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ConnectionStatus"
                                               Text="Disconnected"
                                               FontSize="11" Foreground="#AAA"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right: Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnNewDesktop" Content="NEW DESKTOP"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="30" FontSize="11" Padding="12,4"
                                    Margin="0,0,6,0" Click="BtnNewDesktop_Click"/>
                            <Button x:Name="BtnNewRelay" Content="NEW RELAY"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="30" FontSize="11" Padding="12,4"
                                    Margin="0,0,6,0" Click="BtnNewRelay_Click"/>
                            <Button Content="LOGOUT"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="30" FontSize="11" Padding="12,4"
                                    Click="BtnDisconnect_Click"/>
                            <Button Content="X"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="30" Width="30" FontSize="14" Padding="0"
                                    Margin="12,0,0,0" Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Grid.Column="0" Background="#15152A">
                        <StackPanel x:Name="SessionList"
                                    VerticalAlignment="Top" Margin="8,12,8,8"/>
                    </Border>

                    <!-- Viewer Area -->
                    <Border Grid.Column="1" Background="#0A0A14"
                            BorderBrush="#1A1A2E" BorderThickness="1,0,0,0">
                        <Grid>
                            <controls:RemoteViewer x:Name="RemoteViewerControl"/>
                            <!-- Session overlay info -->
                            <Border Background="#00000088" VerticalAlignment="Top"
                                    Padding="12,8" Visibility="Collapsed"
                                    x:Name="SessionInfoBar">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SessionIdText" Foreground="White" FontSize="12"/>
                                    <TextBlock x:Name="ResolutionText" Foreground="#AAA"
                                               FontSize="12" Margin="16,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2" Background="#1A1A2E" CornerRadius="0,0,12,12"
                        Padding="12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusText" Text="Ready"
                                   FontSize="11" Foreground="#666"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
